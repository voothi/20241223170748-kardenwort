[environment]
; ======================================================================
; IMPORTANT: Fill in the paths for YOUR operating system.
; ======================================================================

; --- Windows Example (use forward slashes or double backslashes) ---
; Path to the Python executable from your virtual environment.
; Both absolute and relative paths are supported.
; A relative path (like the example below) is calculated from the location of this config.ini file.
; This is useful for keeping the virtual environment next to the project folder, making the setup fully portable.
python_executable = ../20250825231214-spacy-env/Scripts/python.exe

; The main workspace directory for the kardenwort project.
; Use './' to specify that the workspace is the same directory
; where this config.ini file is located.
kardenwort_workspace = ./

; The workspace for the anki-importer script.
; This path is relative to the location of config.ini
importer_workspace = ../20250401192017-anki-csv-importer
intellifiller_workspace = ../20251206123938-intellifiller-ai-addon-for-anki


; --- Linux/macOS Example ---
; python_executable = /path/to/your/venv/bin/python
; kardenwort_workspace = ./
; importer_workspace = ../anki-csv-importer

[scripts]
; Names of the executable scripts
kardenwort_script_filename = kardenwort.py
kardenwort_runner_filename = kardenwort_runner.py
importer_script_filename = anki-csv-importer.py

[project_structure]
; Path to the directory with the main source code scripts
source_code_dir = src/kardenwort/core
; Relative directory paths inside the kardenwort_workspace
data_dir = data
source_texts_dir = source_texts
generated_results_dir = results

[input_files]
; Input files (relative to source_texts_dir)
text1_file = text1.txt
text2_file = text2.txt
text3_file = text3.txt

[output_format]
; Template for generating the output filename
; Variables: {mode}, {suffix}, {language}
output_template = result.{mode}.{suffix}.{language}.tsv

; Use HTML <br> tags instead of newlines as separators in the wordlist column
wordlist_use_br = True

; Use HTML <br> tags instead of spaces as separators in context columns
anki_context_use_br = False

; Prepend the output file with the full Anki CSV header
add_header = True

[language_resources]
; Language-specific data files (relative to data_dir)
; Language: English
lemma_file_en = en/english-word-freq-list-370k.csv
override_file_en = en/lemma_override_en.tsv

; Language: German
lemma_file_de = de/deu-mixed-typical-2011-1m-words.csv
override_file_de = de/lemma_override_de.tsv
dictionary_file_de = de/german.dic

[token_mappings]
; Global toggle for easy testing and backward compatibility
enabled = true

; Whether matching against the TSV entries is case-sensitive
case_sensitive = false

; Normalizes typographic characters (e.g. ’ to ')
normalize_apostrophes = true

; Treat internal spaces flexibly (e.g. match 'z.B.' and 'z. B.' equally)
normalize_spaces = true

; Inspect surrounding tokens/capitalization to prevent sentence-boundary false positives
enable_context_disambiguation = true

; Run token mapping output through the lemmatizer (e.g. isn't -> is -> be)
lemmatize_mapped_tokens = true

; When deduplicating globally, combine different source word forms for the same lemma by separating them with a comma
combine_source_words = true

; Language-specific mapping files
en = data/en/lemma_contractions_en.tsv, data/en/lemma_abbreviations_en.tsv
de = data/de/lemma_abbreviations_de.tsv, data/de/lemma_contractions_de.tsv

[anki_importer_settings]
; Settings for the Anki CSV Importer script
note_type = Basic 20240218092126


[optimization]
; Automatically redirect to the lightweight script (sub-100ms) when the input is a single word.
; If the input contains multiple words, normal heavy mode (spaCy) is used.
auto_lite_mode = True


[sendto]
; --- Windows "Send to" integration settings ---

; Default language to fall back on when a sent file has no BCP-47 postfix.
sendto_default_language = en

; Save results back to the directory of the sent files instead of the project results/ folder.
sendto_save_results_with_source = True

; Automatically upload/import the generated TSV cards to Anki.
sendto_upload_to_anki = True

; Extraction mode: mix (both word and sentence passes), word (word-only), or sentence (sentence-only).
sendto_extraction_mode = word

; Subfolder next to source files where results will be moved (e.g. results).
; Leave empty to move results directly to the folder from which you are calling (the root directory).
; Default: results
sendto_relocation_subfolder = vocab

; Console auto-close timeout in seconds (on successful runs in SendTo/pause mode).
; Set to 0 to close instantly; set to -1 or leave empty to disable auto-close.
; Default: 15
sendto_auto_close_timeout_secs = -1

; Mapping of language postfixes to specific slots: 1 (source_sentence), 2 (target_sentence), 3 (tertiary_sentence).
sendto_language_slots = en:1, de:1, ru:3, 1.en:1, 1.de:1, 2.ru:2, 3.ru:3, text1:1, text2:2, text3:3

[pipeline]
stages = extract, fill, import

[classification]
; Enable the dictionary classification mechanism
enabled = true

; Comma-separated list of classifications (name=path) relative to kardenwort_workspace
; Example: oxford=data/en/oxford.tsv, cambridge=data/en/cambridge.tsv
dictionaries_en = oxford=3k:data/en/20260715160822-oxford-3000.en.tsv, oxford=5k:data/en/20260715165539-oxford-5000-expanded.en.tsv
dictionaries_de = goethe=data/de/20260716200932-english-deutsch.de.tsv

[case_sensitivity]
; Control case-sensitivity for frequency index lookup and level-based classification lookup.
; English (en): frequency is case-insensitive, classification is case-sensitive
frequency_en = false
classification_en = true

; German (de): frequency is case-sensitive, classification is case-sensitive
frequency_de = true
classification_de = true
