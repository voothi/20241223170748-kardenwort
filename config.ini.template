[anki_field_mapping.word]
; Define custom mappings for word extraction mode.
; Format: AnkiFieldName = DataSourceName
; 
; Available Data Sources:
; - lemma: The lemmatized word.
; - source_word: The original inflected word.
; - sentence_index: Index of the sentence (e.g., 000001).
; - source_sentence: The source sentence or cloze.
; - deck_name: The name of the deck.
; - wordlist: The list of lemmas in the sentence.
; - source_context_left, source_context_right: Context sentences.
; - target_sentence, target_context_left, target_context_right: Translation content (if available).
; - tertiary_sentence, tertiary_context_left, tertiary_context_right: Tertiary translation content.
; - tts_source_[lang], tts_dest_[lang]: TTS activation flags (set to "1" if languages match).
;
Quotation = source_word
WordSource = lemma
WordSourceInflectedForm = source_word
SentenceSourceContextLeft = source_context_left
SentenceSource = source_sentence
SentenceSourceContextRight = source_context_right
SentenceSourceWordlist = wordlist
SentenceSourceCloze = cloze
SentenceSourceIndex = sentence_index
SentenceDestinationContextLeft = target_context_left
SentenceDestination = target_sentence
SentenceDestinationContextRight = target_context_right
SentenceDestination2ContextLeft = tertiary_context_left
SentenceDestination2 = tertiary_sentence
SentenceDestination2ContextRight = tertiary_context_right
Deck = deck_name
WordSource2 = lemma
WordSourceInflectedForm2 = source_word
Note = subtitle_start_time
; TTS activation fields
Source-en-GB = tts_source_en
Source-en-US = tts_source_us
Source-de-DE = tts_source_de
Source-uk-UA = tts_source_uk
Source-ru-RU = tts_source_ru
Destination-en-GB = tts_dest_en
Destination-en-US = tts_dest_us
Destination-de-DE = tts_dest_de
Destination-uk-UA = tts_dest_uk
Destination-ru-RU = tts_dest_ru

[optimization]
; Automatically redirect to the lightweight script (sub-100ms) when the input is a single word.
; If the input contains multiple words, normal heavy mode (spaCy) is used.
auto_lite_mode = True

[anki_field_mapping.sentence]
; Define custom mappings for sentence extraction mode.
; Format: AnkiFieldName = DataSourceName
; 
; See [anki_field_mapping.word] for available data sources.
;
Quotation = source_sentence
SentenceSourceContextLeft = source_context_left
SentenceSource = source_sentence
SentenceSourceContextRight = source_context_right
SentenceSourceWordlist = wordlist
SentenceSourceCloze = cloze
SentenceSourceIndex = sentence_index
SentenceDestinationContextLeft = target_context_left
SentenceDestination = target_sentence
SentenceDestinationContextRight = target_context_right
SentenceDestination2ContextLeft = tertiary_context_left
SentenceDestination2 = tertiary_sentence
SentenceDestination2ContextRight = tertiary_context_right
Deck = deck_name
Note = subtitle_start_time
; TTS activation fields
Source-en-GB = tts_source_en
Source-en-US = tts_source_us
Source-de-DE = tts_source_de
Source-uk-UA = tts_source_uk
Source-ru-RU = tts_source_ru
Destination-en-GB = tts_dest_en
Destination-en-US = tts_dest_us
Destination-de-DE = tts_dest_de
Destination-uk-UA = tts_dest_uk
Destination-ru-RU = tts_dest_ru

[sendto]
; --- Windows "Send to" integration settings ---

; Default language to fall back on when a sent file has no BCP-47 postfix.
sendto_default_language = en

; Save results back to the directory of the sent files instead of the project results/ folder.
sendto_save_results_with_source = True

; Automatically upload/import the generated TSV cards to Anki.
sendto_upload_to_anki = True

; Extraction mode: mix (both word and sentence passes), word (word-only), or sentence (sentence-only).
sendto_extraction_mode = mix

; Subfolder next to source files where results will be moved (e.g. results).
; Leave empty to move results directly to the folder from which you are calling (the root directory).
; Default: results
sendto_relocation_subfolder = results

; Console auto-close timeout in seconds (on successful runs in SendTo/pause mode).
; Set to 0 to close instantly; set to -1 or leave empty to disable auto-close.
; Default: 15
sendto_auto_close_timeout_secs = -1

; Mapping of language postfixes to specific slots: 1 (source_sentence), 2 (target_sentence), 3 (tertiary_sentence).
sendto_language_slots = en:1, de:1, ru:3, 1.en:1, 1.de:1, 2.ru:2, 3.ru:3, text1:1, text2:2, text3:3
